{
  "name": "DeckVoid light theme",
  "version": "2026-11-04",
  "color": {
    "background": "#FFFFFF",
    "surface": "#FFFFFF",
    "surfaceMuted": "#FAF8F5",
    "line": "#EEEAE4",
    "lineStrong": "#E6DFD4",
    "dashed": "#E2D6C2",
    "chip": "#F3EFE8",
    "bumper": "#F1EADD",
    "text": "#2A2420",
    "textStrong": "#3E352F",
    "textSecondary": "#5A4E45",
    "textMuted": "#6B5F55",
    "textFaint": "#8A7D70",
    "accent": "#F7B267",
    "accentTint": "#FEF0DE",
    "accentDeep": "#B36A1C",
    "secondary": "#D7A6D9",
    "secondaryTint": "rgba(215, 166, 217, 0.28)",
    "statusReady": "#9FD3A8",
    "statusNeedsPairing": "#F7B267",
    "statusAsleep": "#DDD3C3",
    "glyphFill": "#2A2420",
    "glyphText": "#FFFFFF",
    "scrim": "rgba(60, 45, 30, 0.38)"
  },
  "colorRules": [
    "Text is always text/textStrong/textSecondary/textMuted. Accent, secondary and status colours are fills, edges, dots and rings only: they are too light to pass 4.5:1 as text on white.",
    "Text on an accent fill (buttons, Pair) uses text (#2A2420).",
    "accentDeep is for icons on light tints (monitor icon, Add a PC plus, selected settings icon)."
  ],
  "font": {
    "heading": { "family": "Urbanist", "weights": [700, 800], "source": "Google Fonts, SIL Open Font License" },
    "body": { "family": "Quicksand", "weights": [500, 600, 700], "source": "Google Fonts, SIL Open Font License" },
    "fallback": "system sans-serif"
  },
  "typeScale": {
    "controller": { "pageTitle": 34, "dialogTitle": 30, "settingsTitle": 30, "cardTitle": 23, "tab": 21, "row": 19, "body": 17, "meta": 15, "label": 14, "labelTracking": 0.6 },
    "mac":        { "scale": 0.86, "note": "multiply controller sizes by 0.86" },
    "ipad":       { "scale": 0.96, "note": "multiply controller sizes by 0.96" }
  },
  "radius": { "card": 26, "dialog": 30, "control": 22, "pill": 999, "macControl": 8 },
  "spacing": { "pageGutterController": 40, "pageGutterMac": 32, "pageGutterIpad": 32, "gridGap": 20, "cardPadding": 18 },
  "elevation": {
    "focusLift": { "scale": 1.06, "translateY": -6, "shadow": "0 18px 40px rgba(90,60,30,0.22)", "glow": "0 0 0 4px rgba(247,178,103,0.20)" },
    "smallFocus": { "translateY": -3, "shadow": "0 12px 26px rgba(90,60,30,0.18)", "glow": "0 0 0 4px rgba(247,178,103,0.24)" },
    "hoverMac": { "translateY": -4, "shadow": "0 14px 32px rgba(90,60,30,0.18)", "glow": "0 0 0 3px rgba(247,178,103,0.18)" },
    "dialog": "0 24px 60px rgba(60,40,20,0.28)"
  },
  "statusStyle": "edge + dot: a 7px colour strip across the top of the card and an 11px dot before the status word",
  "hitTarget": { "controller": 44, "mac": 28, "ipad": 44 }
}
